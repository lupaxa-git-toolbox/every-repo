#!/usr/bin/env bash
#
# Run commands in every Git repository found recursively below a given path.
#
# A failure is reported, then the next repository still runs, unless --fail-fast.
# By default, no directories are excluded.
#
# --command runs an executable. It does not use a shell.
# --file and --script paths are resolved before entering any repository.
# A relative --command path is resolved inside each repository.
#
# Usage:
#   every-repo [options] <path> --command <command> [args...]
#   every-repo [options] <path> --file <file>
#   every-repo [options] <path> --script <script> [args...]
#   every-repo [options] <path> --list
#
# Examples:
#   every-repo . --list
#   every-repo . --command git status
#   every-repo . --command make init
#
#   every-repo . --file commands.sh
#
#   every-repo . --script ./update-repo.sh
#   every-repo . --script ./update-repo.sh --dry-run
#
#   every-repo --exclude repo-1 --exclude repo-2 \
#       ~/Desktop/GitMaster --file commands.sh

VERSION="0.0.0"

excludes=()
root=""
mode=""
execution_args=()
list_only=false
fail_fast=false
fail_empty=false
find_args=()
failures=()
repos=0
skipped=0
excluded_dirs=0
first_fail_status=0
stop_walk=false

set -euo pipefail

usage()
{
    cat <<EOF
Usage:
  $(basename "$0") [options] <path> --command <command> [args...]
  $(basename "$0") [options] <path> --file <file>
  $(basename "$0") [options] <path> --script <script> [args...]
  $(basename "$0") [options] <path> --list

Options:
  -e, --exclude NAME
      Do not enter a directory with this name.
      Repositories inside it are not run.
      May be specified multiple times.
      The starting path itself is still entered.

  -c, --command COMMAND [ARGS...]
      Execute COMMAND in each repository.
      COMMAND is an executable, not a shell line.
      A relative path is resolved inside each repository.

  -f, --file FILE
      Execute shell commands from FILE in each repository.
      FILE is resolved before entering any repository.

  -s, --script SCRIPT [ARGS...]
      Execute SCRIPT in each repository.
      SCRIPT is resolved before entering any repository.
      Additional arguments are passed to the script.

  -l, --list
      Print repositories that would run, one path per line, and exit.
      No command is executed.

  --fail-fast
      Stop at the first non-zero exit.

  --fail-empty
      Exit with status 1 when no repository ran.

  -V, --version
      Print version and exit.

  -h, --help
      Show this help.

Environment (exported to the command, file, or script):
  EVERY_REPO_ROOT   Absolute starting path
  EVERY_REPO_DIR    Absolute path of the repository
  EVERY_REPO_NAME   Directory name of the repository

Examples:
  $(basename "$0") . --list
  $(basename "$0") . --command git status
  $(basename "$0") . --fail-fast --command make init

  $(basename "$0") . --file commands.sh

  $(basename "$0") . --script ./update-repo.sh
  $(basename "$0") . --script ./update-repo.sh --dry-run

  $(basename "$0") \\
      --exclude repo-1 \\
      --exclude repo-2 \\
      ~/Desktop/GitMaster \\
      --file commands.sh
EOF
}

die()
{
    echo "Error: $1" >&2
    exit 1
}

die_usage()
{
    echo "Error: $1" >&2
    echo >&2
    usage >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

parse_args()
{
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -e|--exclude)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    die "$1 requires a directory name."
                fi

                if [[ "$2" == ".git" ]]; then
                    die "cannot exclude .git."
                fi

                excludes+=("$2")
                shift 2
                ;;

            -c|--command)
                mode="command"
                shift

                if [[ $# -eq 0 ]]; then
                    die "--command requires a command."
                fi

                execution_args=("$@")
                break
                ;;

            -f|--file)
                mode="file"
                shift

                if [[ $# -ne 1 ]]; then
                    die "--file requires exactly one filename."
                fi

                execution_args=("$1")
                break
                ;;

            -s|--script)
                mode="script"
                shift

                if [[ $# -eq 0 ]]; then
                    die "--script requires a script filename."
                fi

                execution_args=("$@")
                break
                ;;

            -l|--list)
                list_only=true
                shift
                ;;

            --fail-fast)
                fail_fast=true
                shift
                ;;

            --fail-empty)
                fail_empty=true
                shift
                ;;

            -V|--version)
                echo "every-repo ${VERSION}"
                exit 0
                ;;

            -h|--help)
                usage
                exit 0
                ;;

            -*)
                die_usage "unknown option: $1"
                ;;

            *)
                if [[ -n "$root" ]]; then
                    die "multiple root paths specified."
                fi

                root="$1"
                shift
                ;;
        esac
    done
}

validate_args()
{
    if [[ -z "$root" ]]; then
        die_usage "a root path is required."
    fi

    if [[ ! -d "$root" ]]; then
        die "directory does not exist: $root"
    fi

    if [[ "$list_only" == true && -n "$mode" ]]; then
        die "--list does not run a command."
    fi

    if [[ "$list_only" == false && -z "$mode" ]]; then
        die_usage "an execution mode is required."
    fi

    root="$(cd "$root" && pwd -P)"
}

resolve_execution_paths()
{
    local target

    case "$mode" in
        file)
            target="${execution_args[0]}"

            if [[ ! -f "$target" ]]; then
                die "command file does not exist: $target"
            fi

            execution_args=("$(absolute_file "$target")")
            ;;

        script)
            target="${execution_args[0]}"

            if [[ ! -f "$target" ]]; then
                die "script does not exist: $target"
            fi

            execution_args[0]="$(absolute_file "$target")"
            ;;
    esac
}

absolute_file()
{
    local target="$1"

    printf '%s/%s\n' "$(cd "$(dirname "$target")" && pwd -P)" "$(basename "$target")"
}

# ---------------------------------------------------------------------------
# Output and search
# ---------------------------------------------------------------------------

emit()
{
    if [[ "$list_only" == true ]]; then
        printf '%s\n' "$1" >&2
    else
        printf '%s\n' "$1"
    fi
}

escape_find_name()
{
    local name="$1"
    local escaped=""
    local index char

    for ((index = 0; index < ${#name}; index++)); do
        char="${name:index:1}"
        case "$char" in
            [*?[])
                escaped+="\\${char}"
                ;;
            \\)
                escaped+="\\\\"
                ;;
            *)
                escaped+="$char"
                ;;
        esac
    done

    printf '%s' "$escaped"
}

is_excluded()
{
    local name="$1"
    local excluded

    if [[ ${#excludes[@]} -eq 0 ]]; then
        return 1
    fi

    for excluded in "${excludes[@]}"; do
        if [[ "$name" == "$excluded" ]]; then
            return 0
        fi
    done

    return 1
}

is_git_file()
{
    local path="$1"
    local first_line=""

    IFS= read -r first_line < "$path" || true
    [[ "$first_line" == gitdir:* ]]
}

run_in_repo()
{
    local dir="$1"
    local name="$2"

    (
        cd "$dir"
        export EVERY_REPO_ROOT="$root"
        export EVERY_REPO_DIR="$dir"
        export EVERY_REPO_NAME="$name"

        case "$mode" in
            command)
                "${execution_args[@]}"
                ;;

            file)
                bash "${execution_args[0]}"
                ;;

            script)
                "${execution_args[@]}"
                ;;

            *)
                echo "Internal error: unknown execution mode: $mode" >&2
                return 1
                ;;
        esac
    )
}

describe_execution()
{
    local description=""
    local quoted=""

    case "$mode" in
        command)
            printf -v quoted ' %q' "${execution_args[@]}"
            description="Command:${quoted}"
            ;;

        file)
            description="Command file: ${execution_args[0]}"
            ;;

        script)
            printf -v quoted ' %q' "${execution_args[@]}"
            description="Script:${quoted}"
            ;;
    esac

    emit "$description"
}

build_find_args()
{
    local name escaped first

    find_args=("$root")

    # -mindepth is global on GNU find and a test on BSD find. Depth 0 is the
    # starting path, which is always entered.
    if [[ ${#excludes[@]} -gt 0 ]]; then
        find_args+=(-mindepth 1 '(' -type d '(')
        first=1
        for name in "${excludes[@]}"; do
            if [[ "$first" -eq 0 ]]; then
                find_args+=(-o)
            fi
            first=0
            escaped="$(escape_find_name "$name")"
            find_args+=(-name "$escaped")
        done
        find_args+=(')' ')' -prune -print0 -o)
    fi

    find_args+=(
        '(' -name .git '(' -type d -o -type f ')' ')' -prune -print0
    )
}

print_configuration()
{
    local excluded_line=""

    emit "Root: $root"

    if [[ "$list_only" == true ]]; then
        emit "List only; no command will run."
    else
        describe_execution
    fi

    if [[ ${#excludes[@]} -gt 0 ]]; then
        printf -v excluded_line ' %s' "${excludes[@]}"
        emit "Excluded directories:${excluded_line}"
    else
        emit "Excluded directories: none"
    fi
}

# ---------------------------------------------------------------------------
# Walk
# ---------------------------------------------------------------------------

note_excluded_path()
{
    local path="$1"

    if [[ -e "$path/.git" ]]; then
        emit ""
        emit "Skipping excluded repository: $path"
        skipped=$((skipped + 1))
    else
        emit ""
        emit "Excluding directory: $path"
        excluded_dirs=$((excluded_dirs + 1))
    fi
}

visit_repository()
{
    local dir="$1"
    local name
    local status

    name="$(basename "$dir")"
    repos=$((repos + 1))

    if [[ "$list_only" == true ]]; then
        printf '%s\n' "$dir"
        return 0
    fi

    echo
    echo "==> $dir"

    status=0
    run_in_repo "$dir" "$name" || status=$?

    if [[ "$status" -eq 0 ]]; then
        return 0
    fi

    echo "Failed in $dir (exit $status)" >&2
    failures+=("$dir (exit $status)")

    if [[ "$first_fail_status" -eq 0 ]]; then
        first_fail_status=$status
    fi

    if [[ "$fail_fast" == true ]]; then
        stop_walk=true
    fi
}

handle_path()
{
    local path="$1"

    if is_excluded "$(basename "$path")"; then
        note_excluded_path "$path"
        return 0
    fi

    if [[ "$(basename "$path")" != ".git" ]]; then
        echo "Internal error: unexpected path from search: $path" >&2
        exit 1
    fi

    if [[ -f "$path" ]] && ! is_git_file "$path"; then
        return 0
    fi

    visit_repository "$(dirname "$path")"
}

process_repositories()
{
    local path

    build_find_args

    while IFS= read -r -d '' path; do
        handle_path "$path"

        if [[ "$stop_walk" == true ]]; then
            break
        fi
    done < <(find "${find_args[@]}")
}

print_summary()
{
    emit ""
    emit "$(printf '%-25s %s' "Repositories processed:" "$repos")"
    emit "$(printf '%-25s %s' "Repositories skipped:" "$skipped")"
    emit "$(printf '%-25s %s' "Directories excluded:" "$excluded_dirs")"
    emit "$(printf '%-25s %s' "Repositories failed:" "${#failures[@]}")"

    if [[ "$repos" -eq 0 && "$skipped" -eq 0 && "$excluded_dirs" -eq 0 ]]; then
        emit ""
        emit "No Git repositories found under: $root"
    fi

    if [[ ${#failures[@]} -gt 0 ]]; then
        return 0
    fi

    if [[ "$list_only" == false && "$repos" -gt 0 ]]; then
        echo
        echo "All processed repositories completed successfully."
    fi
}

print_failures()
{
    local failure

    echo >&2
    echo "Failed repositories:" >&2

    for failure in "${failures[@]}"; do
        printf '  %s\n' "$failure" >&2
    done
}

finish()
{
    if [[ ${#failures[@]} -gt 0 ]]; then
        print_failures

        if [[ "$fail_fast" == true ]]; then
            exit "$first_fail_status"
        fi

        exit 1
    fi

    if [[ "$repos" -eq 0 && "$fail_empty" == true ]]; then
        exit 1
    fi
}

main()
{
    parse_args "$@"
    validate_args
    resolve_execution_paths
    print_configuration
    process_repositories
    print_summary
    finish
}

main "$@"
